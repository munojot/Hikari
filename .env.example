# Hikari Group — Telegram Bot Sozlamalari
# Ushbu faylga o'zingizning Telegram Bot Token va Chat ID ma'lumotlaringizni kiriting

# @BotFather orqali olingan Bot Token (Masalan: 7123456789:AAHk...)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Xabarlar borishi kerak bo'lgan Chat ID (Masalan: 123456789 yoki guruh uchun -1001234567890)
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# Server ishga tushadigan port
PORT=8080
